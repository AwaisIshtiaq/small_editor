t type=\"radio\" name=\"addMargins\" value=\"false\" checked=\"\"> Leave unchanged\n                </label>\n                <label class=\"btn btn-default btn-xs\">\n                  <input type=\"radio\" name=\"addMargins\" value=\"true\"> Increase margins\n                  <span class=\"input-help\">\n                        <i class=\"fal fa-question-circle\" data-toggle=\"tooltip\" data-placement=\"top\" data-html=\"true\" title=\"\" data-original-title=\"Increase document margins to avoid overlapping existing text.\"></i>\n                      </span>\n                </label>\n              </div>\n            </div>\n\n            <div class=\"head-space more-options\" style=\"display: none\" id=\"hf-more-options\">\n              <div class=\"row head-space-xl\">\n                <label>Apply only to pages</label><br>\n                <input data-validator=\"page-ranges-or-predefined\" id=\"specificPages\" name=\"pages\" type=\"text\" class=\"form-control input-lg thumbs-multiple-select\" placeholder=\"Example: 1-10 or 12- or odd or even or 2,4,6,10\" min=\"1\" value=\"\" style=\"width: 400px\">\n\n                <span class=\"input-help\">\n              <i class=\"fal fa-question-circle\" data-toggle=\"tooltip\" data-placement=\"top\" data-html=\"true\" title=\"\" data-original-title=\"Don't want to apply the header to the whole document? Enter page ranges like 1-10,13,15- or even, odd. Header or footer will only be applied to these specific pages.\"></i>\n            </span>\n              </div>\n              <div class=\"row head-space-xl\">\n                <label>Start numbering from</label><br>\n                <input type=\"text\" name=\"pageCountStartFrom\" class=\"form-control input-lg\" placeholder=\"1\" value=\"\" style=\"width: 75px\">\n                <span class=\"input-help\">\n                  <i class=\"fal fa-question-circle\" data-toggle=\"tooltip\" data-placement=\"top\" data-html=\"true\" title=\"\" data-original-title=\"Helpfu